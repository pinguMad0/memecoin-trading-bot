# Public RPC and wallet address used for quotes and simulation.
HELIUS_RPC_URL=
WALLET_PUBKEY=

# Live execution is off by default. PRIVATE_KEY is only needed for live trades.
LIVE=false
PRIVATE_KEY=
EXEC_BROKER=pumpswap
DUST_STAKE_SOL=0.01
LIVE_SLIPPAGE_BPS=1000
SELFTEST_MINT=

# Broker endpoints.
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JITO_BLOCK_ENGINE=https://mainnet.block-engine.jito.wtf/api/v1/bundles
CURVE_JUP_API=https://lite-api.jup.ag/swap/v1

# Entry checks and exit sampling.
RUG_AUDIT=on
DRAIN_AUDIT=on
EXIT_SAMPLER=pool

# Local dashboard.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5300
PAPER_WALLET_START_SOL=0.1

# Paper curve executor.
CURVE_POLL_S=30
CURVE_EXEC_SIZE_SOL=0.01
CURVE_MAX_POSITIONS=3
CURVE_QUOTE_DEVIATION_MAX_PCT=3
CURVE_SLIPPAGE_BPS=500
CURVE_MOM_CAP_PCT=150
CURVE_MOONBAG_X=2.0
CURVE_TRAIL_DROP_PCT=40
CURVE_POSITION_MAX_S=3600

# Curve feed gate.
CURVE_MIN_AGE_S=90
CURVE_MAX_AGE_S=1800
CURVE_MIN_PROGRESS_PCT=2
CURVE_MAX_PROGRESS_PCT=92
CURVE_MIN_MC_USD=3500
CURVE_MAX_MC_USD=16000
CURVE_WATCH_CAP=40
CURVE_MOM_PCT=0.15
CURVE_MOM_LOOKBACK_S=300
